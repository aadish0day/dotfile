[user]
	name = Aadishx07
	email = aadishdas7@gmail.com
[filter "lfs"]
	process = git-lfs filter-process
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
    required = true
[init]
	defaultBranch = main
[core]
	editor = nvim
	sshCommand = ssh -C
[color]
	ui = auto
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[alias]
	dt = difftool
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
