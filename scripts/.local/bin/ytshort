#!/usr/bin/env bash
# ytshort — download YouTube videos as web/WordPress-friendly MP4 into the current dir
# Usage: ytshort URL...
# Grabs H.264/AAC (<=1080p) directly so most videos need no re-encode;
# anything else is converted with conv4wp.
set -uo pipefail

if (($# == 0)); then
    sed -n '2,5p' "$0"
    exit 1
fi
for dep in yt-dlp ffmpeg ffprobe; do
    command -v "$dep" >/dev/null || {
        echo "missing dependency: $dep" >&2
        exit 1
    }
done

here=$(dirname "$(readlink -f "$0")")
conv="$here/conv4wp"
[[ -x $conv ]] || conv=$(command -v conv4wp) || {
    echo "missing conv4wp" >&2
    exit 1
}

# Work dir lives in the current dir (not /tmp, which is often RAM-backed)
tmp=""
cleanup() { [[ -n $tmp ]] && rm -rf -- "$tmp"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

codec() { ffprobe -v error -select_streams "$1" -show_entries stream=codec_name -of csv=p=0 "$2" 2>/dev/null | head -n1; }

finish_file() {
    local f=$1 out final
    final="./$(basename "${f%.*}").mp4"
    if [[ ${f##*.} == mp4 && $(codec v:0 "$f") == h264 && $(codec a:0 "$f") == aac ]]; then
        mv -n -- "$f" "$final" && echo "✓ ${final#./}"
        return
    fi
    echo "Converting: $(basename "$f")"
    if [[ ${f##*.} == mp4 ]]; then out="${f%.mp4}_converted.mp4"; else out="${f%.*}.mp4"; fi
    if "$conv" -t "$f" && mv -n -- "$out" "$final"; then
        echo "✓ ${final#./}"
    else
        echo "✗ Failed to convert: $(basename "$f")"
        return 1
    fi
}

failed=()
for url in "$@"; do
    echo
    echo "→ $url"
    tmp=$(mktemp -d -p "$PWD" .ytshort.XXXXXX) || exit 1

    if yt-dlp --no-warnings \
        -f 'bv*[height<=1080]+ba/b[height<=1080]' \
        -S 'res,vcodec:h264,acodec:aac' \
        --merge-output-format mp4 \
        --embed-metadata --embed-thumbnail --write-thumbnail --convert-thumbnails jpg \
        -N 8 --retries 10 --fragment-retries 10 \
        -o "$tmp/%(title)s.%(ext)s" "$url"; then
        shopt -s nullglob
        for f in "$tmp"/*.mp4 "$tmp"/*.webm "$tmp"/*.mkv "$tmp"/*.flv "$tmp"/*.m4v; do
            finish_file "$f" || failed+=("$url")
        done
        shopt -u nullglob
    else
        echo "✗ Failed to download: $url"
        failed+=("$url")
    fi
    rm -rf -- "$tmp"
    tmp=""
done

if ((${#failed[@]})); then
    echo
    echo "⚠ failed (${#failed[@]}):"
    printf '  %s\n' "${failed[@]}"
    exit 1
fi
echo
echo "✓ done"
