#!/usr/bin/env bash

[[ -n ${TMUX:-} ]] || {
    echo "Run this inside tmux." >&2
    exit 1
}

# Get the list of tmux sessions excluding the current one
attached_session=$(tmux display-message -p '#{session_name}')
sessions=$(tmux list-sessions -F "#{session_name}" | grep -vxF -- "$attached_session")

# Use fzf-tmux to select a session
if [[ -n "$sessions" ]]; then
    selected_session=$(echo "$sessions" | fzf-tmux -p 50%,50% --prompt="Select a tmux session: " --border --layout=reverse --color=bg:-1,bg+:#313244,fg+:#cba6f7:bold,gutter:-1)

    # If a session was selected, switch to it
    if [[ -n "$selected_session" ]]; then
        tmux switch-client -t "$selected_session"
    fi
else
    tmux display-message "No available sessions to attach."
fi
