#!/usr/bin/env bash
# ytmusic — download audio from YouTube / YT Music URLs
# Usage: ytmusic [-f m4a|opus|mp3] [-d DIR] [-F urls.txt] [-c browser|file] [-s] [-r] URL...
#   -f  format (default m4a)
#   -d  output dir (default $MUSIC_DIR or ~/Music/ytmusic)
#   -F  file with URLs, one per line (# comments ok)
#   -c  cookies from browser (firefox, chrome, etc.) or cookies.txt file
#   -s  cut non-music parts (SponsorBlock music_offtopic)
#   -r  re-download: ignore the archive and overwrite existing files (re-tag / add cover art)
# Env: COOKIES=firefox|chrome|file.txt  -> use browser or file cookies
set -uo pipefail

FMT="m4a"
DIR="${MUSIC_DIR:-$HOME/Music/ytmusic}"
ARCHIVE="$HOME/.ytmusic_archive.txt"
LIST=""
SB=0
REDO=0
COOKIE_ARG=""

usage() {
    sed -n '2,10p' "$0"
    exit 1
}

while getopts "f:d:F:c:srh" o; do
    case $o in
    f) FMT=$OPTARG ;;
    d) DIR=$OPTARG ;;
    F) LIST=$OPTARG ;;
    c) COOKIE_ARG=$OPTARG ;;
    s) SB=1 ;;
    r) REDO=1 ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))

# Separate archive per format, so switching m4a <-> opus does not skip everything
[[ $FMT == m4a ]] || ARCHIVE="$HOME/.ytmusic_archive_$FMT.txt"

urls=("$@")
if [[ -n $LIST ]]; then
    while IFS= read -r l; do
        [[ $l =~ ^[[:space:]]*(#|$) ]] || urls+=("$l")
    done <"$LIST"
fi
((${#urls[@]})) || usage

for dep in yt-dlp ffmpeg; do
    command -v "$dep" >/dev/null || {
        echo "missing dependency: $dep"
        exit 1
    }
done

if [[ $FMT == m4a ]] && ! command -v AtomicParsley >/dev/null && ! command -v atomicparsley >/dev/null &&
    ! python3 -c 'import mutagen' 2>/dev/null; then
    echo "note: install python-mutagen or atomicparsley, otherwise cover art may not show in your music app" >&2
fi

# m4a: prefer native AAC stream -> remux only, no quality loss.
# opus: native YouTube codec, best quality per bitrate.
case $FMT in
m4a) SEL='bestaudio[ext=m4a]/bestaudio' ;;
opus) SEL='bestaudio[acodec=opus]/bestaudio' ;;
mp3) SEL='bestaudio' ;;
*)
    echo "bad format: $FMT (m4a|opus|mp3)"
    exit 1
    ;;
esac

args=(
    -f "$SEL"
    -x --audio-format "$FMT" --audio-quality 0
    --embed-metadata --embed-thumbnail --convert-thumbnails jpg
    # Cover art: square-crop the 16:9 thumbnail so music apps show it properly
    --ppa 'ThumbnailsConvertor+ffmpeg_o:-vf "crop=min(iw\\,ih):min(iw\\,ih)"'
    # Tags: clean title, artist (" - Topic" stripped), album (album, else playlist name),
    # album artist (groups albums in players), track number, year
    --parse-metadata '%(track,title)s:%(meta_title)s'
    --parse-metadata '%(artist,creator,uploader|)s:%(meta_artist)s'
    --parse-metadata '%(album_artist,artist,creator,uploader|)s:%(meta_album_artist)s'
    --parse-metadata '%(album,playlist_title|)s:%(meta_album)s'
    --parse-metadata '%(track_number,playlist_index|)s:%(meta_track)s'
    --parse-metadata '%(release_year|)s:%(meta_date)s'
    --replace-in-metadata 'meta_artist,meta_album_artist' ' - Topic$' ''
    -N 4
    --no-overwrites
    --download-archive "$ARCHIVE"
    --no-warnings
    -o "$DIR/%(playlist_title|Singles)s/%(track,title)s.%(ext)s"
)
((SB)) && args+=(--sponsorblock-remove music_offtopic)
((REDO)) && args+=(--no-download-archive --force-overwrites)
C_SRC="${COOKIE_ARG:-${COOKIES:-}}"
if [[ -n $C_SRC ]]; then
    if [[ -f $C_SRC ]]; then
        args+=(--cookies "$C_SRC")
    else
        args+=(--cookies-from-browser "$C_SRC")
    fi
fi

failed=()
for url in "${urls[@]}"; do
    echo "→ $url"
    yt-dlp "${args[@]}" "$url" || failed+=("$url")
done

if ((${#failed[@]})); then
    echo "⚠ failed (${#failed[@]}):"
    printf '  %s\n' "${failed[@]}"
    exit 1
fi
echo "✓ done → $DIR"
