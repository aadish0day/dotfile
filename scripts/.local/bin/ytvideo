#!/usr/bin/env bash

set -e

OPTS=()
URLS=()
HAS_OUTPUT=0
HAS_PATH=0

while (($# > 0)); do
    case "$1" in
        -o|--output)
            HAS_OUTPUT=1
            OPTS+=("$1")
            if (($# > 1)); then OPTS+=("$2"); shift; fi
            ;;
        -P|--paths)
            HAS_PATH=1
            OPTS+=("$1")
            if (($# > 1)); then OPTS+=("$2"); shift; fi
            ;;
        -*)
            OPTS+=("$1")
            case "$1" in
                -f|--format|-S|--format-sort|-I|--playlist-items|--proxy|--download-archive|--match-filters|--sub-langs|--audio-format|-r|--limit-rate|--date|--datebefore|--dateafter|--cookies|--config-locations|--add-headers)
                    if (($# > 1)); then OPTS+=("$2"); shift; fi
                    ;;
            esac
            ;;
        *)
            URLS+=("$1")
            ;;
    esac
    shift
done

if ((${#URLS[@]} == 0)); then
    echo "Usage: $0 [yt-dlp options] <URL1> [URL2 ... URLn]"
    exit 1
fi

EXTRA_OPTS=()
if ((HAS_OUTPUT == 0)); then
    # Use playlist title only if part of a playlist (avoids creating an "NA" folder)
    EXTRA_OPTS+=(-o "%(playlist_title&{}/|)s%(title)s.%(ext)s")
fi

for url in "${URLS[@]}"; do
    yt-dlp \
        "${OPTS[@]}" \
        "${EXTRA_OPTS[@]}" \
        -f "bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080]" \
        --merge-output-format mp4 \
        --embed-metadata \
        --embed-thumbnail \
        --convert-thumbnails jpg \
        --concurrent-fragments 30 \
        --retries infinite \
        --continue \
        --download-archive ~/.yt-dlp-archive.txt \
        "$url"
done

# Detect environment: Termux / Android vs Arch Linux / Desktop
IS_ANDROID=0
if [ -n "${TERMUX_VERSION:-}" ] || [ -d "/data/data/com.termux" ] || [ -d "$HOME/storage" ]; then
    IS_ANDROID=1
fi

# Post-download processing:
if ((IS_ANDROID == 1)); then
    # Trigger Android media scanner on recently created videos in current directory
    find . -maxdepth 2 -type f \( -name "*.mp4" -o -name "*.mkv" -o -name "*.webm" \) -mmin -10 2>/dev/null | while read -r f; do
        am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$(realpath "$f")" >/dev/null 2>&1 || true
        if command -v termux-media-scan >/dev/null 2>&1; then
            termux-media-scan "$f" >/dev/null 2>&1 || true
        fi
    done
fi
