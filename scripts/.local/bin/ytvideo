#!/usr/bin/env bash
# ytvideo — download video(s) as MP4 (<=1080p). Any yt-dlp option can be added;
# defaults are placed first, so whatever you pass overrides them.
# Usage: ytvideo [yt-dlp options] URL...
#   e.g. ytvideo -f 'bv*+ba' --no-download-archive https://youtu.be/...
set -uo pipefail

if (($# == 0)); then
    sed -n '2,5p' "$0"
    exit 1
fi
for dep in yt-dlp ffmpeg; do
    command -v "$dep" >/dev/null || {
        echo "missing dependency: $dep" >&2
        exit 1
    }
done

# Collect final file paths so Android can rescan them
list=$(mktemp -t ytvideo.XXXXXX)
trap 'rm -f -- "$list"' EXIT
trap 'exit 130' INT TERM

# %(playlist_title&{}/|)s -> "<playlist>/" for playlists, nothing for single videos
yt-dlp \
    -f 'bv*[height<=1080][ext=mp4]+ba[ext=m4a]/bv*[height<=1080]+ba/b[height<=1080]' \
    --merge-output-format mp4 \
    --embed-metadata --embed-thumbnail --convert-thumbnails jpg \
    -N 8 --retries 10 --fragment-retries 10 --continue \
    --download-archive ~/.yt-dlp-archive.txt \
    -o '%(playlist_title&{}/|)s%(title)s.%(ext)s' \
    --print-to-file 'after_move:filepath' "$list" \
    "$@"
rc=$?

# Termux / Android: make new files show up in the gallery
if [[ -n ${TERMUX_VERSION:-} || -d /data/data/com.termux ]]; then
    while IFS= read -r f; do
        [[ -f $f ]] || continue
        f=$(realpath -- "$f")
        if command -v termux-media-scan >/dev/null 2>&1; then
            termux-media-scan "$f" >/dev/null 2>&1
        else
            am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$f" >/dev/null 2>&1
        fi
    done <"$list"
fi

exit "$rc"
