#!/usr/bin/env bash
# conv4wp — convert videos to web/WordPress-friendly MP4 (H.264 + AAC, faststart)
# Usage: conv4wp [-t] FILE...
#   -t  attach sibling <name>.jpg/.png as cover art
# Inputs that are already .mp4 are written to <name>_converted.mp4.
set -uo pipefail

usage() {
    sed -n '2,5p' "$0"
    exit 1
}

THUMB=0
while getopts "th" o; do
    case $o in
    t) THUMB=1 ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))
(($#)) || usage
command -v ffmpeg >/dev/null || {
    echo "missing dependency: ffmpeg" >&2
    exit 1
}

tmp=""
trap '[[ -n $tmp ]] && rm -f -- "$tmp"' EXIT
trap 'exit 130' INT TERM

convert() {
    local in=$1 base out thumb="" t
    [[ -f $in ]] || {
        echo "✗ File not found: $in"
        return 1
    }
    base=${in%.*}
    if [[ ${in##*.} == [mM][pP]4 ]]; then
        out="${base}_converted.mp4"
    else
        out="${base}.mp4"
    fi
    if [[ -e $out ]]; then
        echo "⚠ Output already exists: $out"
        return 0
    fi

    if ((THUMB)); then
        for t in jpg jpeg png; do
            if [[ -f ${base}.$t ]]; then
                thumb="${base}.$t"
                break
            fi
        done
    fi

    echo "Converting: $in"
    # Write to a .part file so an interrupted run never leaves a "finished" file
    tmp="${out%.mp4}.part.mp4"
    local args=(-nostdin -hide_banner -loglevel error -stats -i "$in")
    if [[ -n $thumb ]]; then
        args+=(-i "$thumb" -map '0:V:0' -map '0:a:0?' -map 1
            -c:v:1 copy -disposition:v:1 attached_pic)
    else
        args+=(-map '0:V:0' -map '0:a:0?')
    fi
    args+=(-c:v:0 libx264 -profile:v:0 high -pix_fmt:v:0 yuv420p -crf 23 -preset medium
        -c:a aac -b:a 128k -movflags +faststart "$tmp")

    if ffmpeg "${args[@]}" && mv -- "$tmp" "$out"; then
        echo "✓ $out"
        tmp=""
    else
        echo "✗ Failed: $in"
        rm -f -- "$tmp"
        tmp=""
        return 1
    fi
}

fail=0
for f in "$@"; do
    convert "$f" || fail=1
done
exit "$fail"
