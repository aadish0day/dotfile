#!/usr/bin/env bash

# ==============================================================================
# ADB Screen Brightness Controller (Pure Bash TUI)
# Interactive terminal interface with live slider, presets & device status.
# ==============================================================================

set -u

# --- Terminal Setup & Cleanup (TUI mode only) ---
TUI=0
cleanup() {
    ((TUI)) || return 0
    TUI=0
    # Re-disable mouse reporting modes in case terminal left them on
    printf "\033[?1000l\033[?1002l\033[?1003l\033[?1006l" 2>/dev/null || true
    # Restore cursor, normal screen buffer, and echo
    tput cnorm 2>/dev/null || true
    tput rmcup 2>/dev/null || true
    stty echo 2>/dev/null || true
    echo ""
}
trap cleanup EXIT
trap 'exit 130' INT TERM # exit (so EXIT trap restores the terminal) instead of carrying on

tui_setup() {
    TUI=1
    # Explicitly disable mouse reporting modes to eliminate mouse-movement jitter
    printf "\033[?1000l\033[?1002l\033[?1003l\033[?1006l" 2>/dev/null || true
    # Alternate screen buffer, hide cursor, no input echo
    tput smcup 2>/dev/null || true
    tput civis 2>/dev/null || true
    stty -echo 2>/dev/null || true
}

# --- ANSI Styles & Colors ---
ESC=$'\033'
NC="${ESC}[0m"
BOLD="${ESC}[1m"
DIM="${ESC}[2m"
REVERSE="${ESC}[7m"

# Colors
RED="${ESC}[31m"
YELLOW="${ESC}[33m"
CYAN="${ESC}[36m"

# Bright Colors
B_CYAN="${ESC}[1;36m"
B_GREEN="${ESC}[1;32m"
B_YELLOW="${ESC}[1;33m"
B_WHITE="${ESC}[1;37m"

# --- State Variables ---
DEVICE_ID=""
DEVICE_MODEL="Unknown"
BATTERY_LEVEL="--"
IS_CHARGING=false
CURRENT_VAL=128
MAX_VAL=255 # auto-detected from the device (dumpsys power)
STEP=5
COARSE=20
ADB=(adb)
AUTO_MODE=0
LAST_MSG="Ready. Use arrow keys or presets to adjust."
SELECTED_INDEX=0

# Presets Table: (Percent, Label <= 13 chars, Value)
PRESETS_PCT=(100 95 90 85 80 75 70 65 60 55 50 45 40 35 30 20 10 5 2 0)
PRESETS_NAME=(
    "Maximum"
    "Ultra High"
    "Very High"
    "Outdoor High"
    "High"
    "Optimal High"
    "Above Medium"
    "Medium-High"
    "Balanced High"
    "Balanced"
    "Half / Medium"
    "Balanced Low"
    "Low-Medium"
    "Comfort High"
    "Comfort"
    "Low"
    "Dim / Reading"
    "Bedtime"
    "Ultra Low"
    "Pitch Dark"
)
PRESETS_VAL=() # filled by init_presets once MAX_VAL is known
TOTAL_PRESETS=${#PRESETS_PCT[@]}

# --- Hardware / ADB Interaction Functions ---

# adb with a timeout, so an offline device can't hang the UI or a status bar
adbx() { timeout 5 "${ADB[@]}" "$@"; }

# Pick the device (ANDROID_SERIAL, else first authorized one) and pin adb to it
require_device() {
    if ! command -v adb &>/dev/null; then
        echo "adb not found. Install it and make sure it is in PATH." >&2
        return 1
    fi
    DEVICE_ID="${ANDROID_SERIAL:-$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1; exit}')}"
    if [ -z "$DEVICE_ID" ]; then
        echo "No authorized Android device found via adb (enable USB debugging and authorize this PC)." >&2
        return 1
    fi
    ADB=(adb -s "$DEVICE_ID")
}

# One adb round-trip for everything we need. Returns 1 if brightness couldn't be read.
read_state() {
    local out line cur_val="" cur_mode="" max=""
    # shellcheck disable=SC2016 # expansion must happen on the device
    out=$(adbx shell 'echo "model=$(getprop ro.product.model)"; echo "val=$(settings get system screen_brightness)"; echo "mode=$(settings get system screen_brightness_mode)"; echo "max=$(dumpsys power | grep -m1 mMaximumScreenBrightnessSetting | cut -d= -f2)"; dumpsys battery' 2>/dev/null | tr -d '\r') || true

    IS_CHARGING=false
    while IFS= read -r line; do
        case $line in
        model=*) DEVICE_MODEL=${line#model=} ;;
        val=*) cur_val=${line#val=} ;;
        mode=*) cur_mode=${line#mode=} ;;
        max=*) max=${line#max=} ;;
        *"AC powered: true"* | *"USB powered: true"* | *"Wireless powered: true"*) IS_CHARGING=true ;;
        *)
            if [[ $line =~ ^[[:space:]]+level:[[:space:]]*([0-9]+) ]]; then
                BATTERY_LEVEL=${BASH_REMATCH[1]}
            fi
            ;;
        esac
    done <<<"$out"

    [ -z "$DEVICE_MODEL" ] && DEVICE_MODEL="Android Device"
    [ "$BATTERY_LEVEL" = "--" ] && BATTERY_LEVEL="??"
    if [[ $max =~ ^[0-9]+$ ]] && ((max > 1)); then MAX_VAL=$max; fi
    if [ "$cur_mode" = "1" ]; then AUTO_MODE=1; else AUTO_MODE=0; fi
    if [[ $cur_val =~ ^[0-9]+$ ]]; then
        CURRENT_VAL=$cur_val
        return 0
    fi
    return 1
}

# Preset values and step sizes scale with the device's brightness range
init_presets() {
    local p v
    STEP=$((MAX_VAL * 2 / 100))
    ((STEP < 1)) && STEP=1
    COARSE=$((MAX_VAL * 8 / 100))
    ((COARSE < 1)) && COARSE=1
    PRESETS_VAL=()
    for p in "${PRESETS_PCT[@]}"; do
        v=$((p * MAX_VAL / 100))
        ((v < 1)) && v=1
        PRESETS_VAL+=("$v")
    done
}

fetch_device_info() {
    read_state || true
    init_presets

    # Find closest preset for initial selection
    local min_diff=$((MAX_VAL + 1))
    local best_idx=0
    for ((i = 0; i < TOTAL_PRESETS; i++)); do
        local diff=$((CURRENT_VAL - PRESETS_VAL[i]))
        diff=${diff#-} # absolute value
        if ((diff < min_diff)); then
            min_diff=$diff
            best_idx=$i
        fi
    done
    SELECTED_INDEX=$best_idx
}

# set_brightness <1..MAX_VAL>: manual mode + value in a single adb call
set_brightness() {
    adbx shell "settings put system screen_brightness_mode 0; settings put system screen_brightness $1" 2>/dev/null
}

apply_brightness() {
    local target="$1"
    local label="${2:-}"

    if ((target < 1)); then target=1; fi
    if ((target > MAX_VAL)); then target=$MAX_VAL; fi

    if ! set_brightness "$target"; then
        LAST_MSG="adb command failed - is the device still connected?"
        return
    fi
    CURRENT_VAL=$target
    AUTO_MODE=0

    local pct=$((target * 100 / MAX_VAL))
    if [ -n "$label" ]; then
        LAST_MSG="Set: ${label} -> ${target}/${MAX_VAL} (${pct}%)"
    else
        LAST_MSG="Adjusted to ${target}/${MAX_VAL} (${pct}%)"
    fi
}

toggle_auto_mode() {
    local new=1 msg="Auto-brightness ENABLED (Adaptive)"
    if [ "$AUTO_MODE" -eq 1 ]; then
        new=0
        msg="Auto-brightness DISABLED (Manual Mode)"
    fi
    if adbx shell settings put system screen_brightness_mode "$new" 2>/dev/null; then
        AUTO_MODE=$new
        LAST_MSG=$msg
    else
        LAST_MSG="adb command failed - is the device still connected?"
    fi
}

prompt_custom_value() {
    tput cnorm 2>/dev/null || true
    stty echo 2>/dev/null || true

    # Move cursor to notification row
    tput cup 20 0 2>/dev/null || true
    printf "\r${B_CYAN}│ %-63s │${NC}\n" " "
    tput cup 20 2 2>/dev/null || true

    local input=""
    read -r -p "Enter custom value (1 - $MAX_VAL): " input

    tput civis 2>/dev/null || true
    stty -echo 2>/dev/null || true

    if [[ "$input" =~ ^[0-9]+$ ]] && ((input >= 1 && input <= MAX_VAL)); then
        apply_brightness "$input" "Custom Value"
    else
        LAST_MSG="Invalid input! Value must be 1 - ${MAX_VAL}."
    fi
}

# --- TUI Drawing Functions (Atomic Fast Double-Buffering) ---

render_tui() {
    local inner_w=65
    local buf=""

    append() {
        local tmp
        # shellcheck disable=SC2059 # callers pass the format as $1 on purpose
        printf -v tmp "$@"
        buf+="${tmp}\n"
    }

    # Home cursor (no clear screen = zero flicker)
    buf+="${ESC}[H"

    # Top border
    append "${B_CYAN}╭─────────────────────────────────────────────────────────────────╮${NC}"

    # Title row (len 38, centered in 65 cols -> pad 13 left, 14 right)
    local title="ADB SCREEN BRIGHTNESS CONTROLLER (TUI)"
    append "${B_CYAN}│${NC}%*s${B_WHITE}%s${NC}%*s${B_CYAN}│${NC}" 13 "" "$title" 14 ""
    append "${B_CYAN}├─────────────────────────────────────────────────────────────────┤${NC}"

    # Device & Battery row
    local dev_plain=" Device: ${DEVICE_MODEL}"
    if ((${#dev_plain} > 30)); then dev_plain="${dev_plain:0:30}"; fi

    local chg_tag="[Battery]"
    if [ "$IS_CHARGING" = true ]; then chg_tag="[Charging]"; fi

    local bat_plain="Battery: ${BATTERY_LEVEL}% ${chg_tag} "
    local pad1=$((inner_w - ${#dev_plain} - ${#bat_plain}))
    if ((pad1 < 1)); then pad1=1; fi

    local bat_color="${B_GREEN}"
    if [[ "$BATTERY_LEVEL" =~ ^[0-9]+$ ]]; then
        if ((BATTERY_LEVEL < 20)); then
            bat_color="${RED}"
        elif ((BATTERY_LEVEL < 45)); then
            bat_color="${YELLOW}"
        fi
    fi

    append "${B_CYAN}│${NC}%s%*sBattery: %s%s%%%s %s ${B_CYAN}│${NC}" \
        "$dev_plain" "$pad1" "" "$bat_color" "$BATTERY_LEVEL" "$NC" "$chg_tag"

    # Slider row (26 character visual bar)
    local bar_len=26
    local filled=$((CURRENT_VAL * bar_len / MAX_VAL))
    local empty=$((bar_len - filled))
    local pct=$((CURRENT_VAL * 100 / MAX_VAL))

    local bar_str=""
    for ((b = 0; b < filled; b++)); do bar_str+="█"; done
    local empty_str=""
    for ((b = 0; b < empty; b++)); do empty_str+="░"; done

    local slider_plain
    printf -v slider_plain " Brightness: [%s%s] %3d%% (%3d/%d) " "$bar_str" "$empty_str" "$pct" "$CURRENT_VAL" "$MAX_VAL"
    local pad_s=$((inner_w - ${#slider_plain}))
    if ((pad_s < 0)); then pad_s=0; fi

    append "${B_CYAN}│${NC} Brightness: [${B_GREEN}%s${NC}${DIM}%s${NC}] ${B_WHITE}%3d%%${NC} (${CYAN}%3d${NC}/%d) %*s${B_CYAN}│${NC}" \
        "$bar_str" "$empty_str" "$pct" "$CURRENT_VAL" "$MAX_VAL" "$pad_s" ""

    # Mode & Device ID row
    local mode_plain=" Mode: [Manual Mode]"
    local mode_styled=" Mode: ${B_YELLOW}[Manual Mode]${NC}"
    if [ "$AUTO_MODE" -eq 1 ]; then
        mode_plain=" Mode: [Auto/Adaptive ON]"
        mode_styled=" Mode: ${B_CYAN}[Auto/Adaptive ON]${NC}"
    fi

    local dev_id_plain="Device ID: ${DEVICE_ID} "
    if ((${#dev_id_plain} > 28)); then dev_id_plain="${dev_id_plain:0:28}"; fi

    local pad2=$((inner_w - ${#mode_plain} - ${#dev_id_plain}))
    if ((pad2 < 1)); then pad2=1; fi

    append "${B_CYAN}│${NC}%s%*s${DIM}%s${NC}${B_CYAN}│${NC}" "$mode_styled" "$pad2" "" "$dev_id_plain"

    # Presets Header
    append "${B_CYAN}├────────────────────────────────┬────────────────────────────────┤${NC}"
    local h_l="     PRESETS (100% - 55%)       "
    local h_r="      PRESETS (50% - 0%)        "
    append "${B_CYAN}│${NC}${BOLD}%s${NC}${B_CYAN}│${NC}${BOLD}%s${NC}${B_CYAN}│${NC}" "$h_l" "$h_r"
    append "${B_CYAN}├────────────────────────────────┼────────────────────────────────┤${NC}"

    # Presets Rows (10 rows for 20 presets, each exactly 32 chars per column)
    for row in {0..9}; do
        local left_i=$row
        local right_i=$((row + 10))

        # --- Left Column ---
        local lpct=${PRESETS_PCT[left_i]}
        local lname=${PRESETS_NAME[left_i]}
        local lval=${PRESETS_VAL[left_i]}
        local l_sel=false
        [ "$left_i" -eq "$SELECTED_INDEX" ] && l_sel=true
        local l_act=false
        [ "$lval" -eq "$CURRENT_VAL" ] && l_act=true

        local l_mark="  "
        if [ "$l_sel" = true ]; then l_mark="> "; fi
        local l_stat="  "
        if [ "$l_act" = true ]; then l_stat="* "; fi

        local l_plain
        printf -v l_plain "%s[%3d%%] %-13s [%4d] %s" "$l_mark" "$lpct" "$lname" "$lval" "$l_stat"

        local l_styled
        if [ "$l_sel" = true ]; then
            l_styled="${REVERSE}${BOLD}${B_CYAN}${l_plain}${NC}"
        elif [ "$l_act" = true ]; then
            l_styled="${B_GREEN}${l_plain}${NC}"
        else
            l_styled="${l_plain}"
        fi

        # --- Right Column ---
        local rpct=${PRESETS_PCT[right_i]}
        local rname=${PRESETS_NAME[right_i]}
        local rval=${PRESETS_VAL[right_i]}
        local r_sel=false
        [ "$right_i" -eq "$SELECTED_INDEX" ] && r_sel=true
        local r_act=false
        [ "$rval" -eq "$CURRENT_VAL" ] && r_act=true

        local r_mark="  "
        if [ "$r_sel" = true ]; then r_mark="> "; fi
        local r_stat="  "
        if [ "$r_act" = true ]; then r_stat="* "; fi

        local r_plain
        printf -v r_plain "%s[%3d%%] %-13s [%4d] %s" "$r_mark" "$rpct" "$rname" "$rval" "$r_stat"

        local r_styled
        if [ "$r_sel" = true ]; then
            r_styled="${REVERSE}${BOLD}${B_CYAN}${r_plain}${NC}"
        elif [ "$r_act" = true ]; then
            r_styled="${B_GREEN}${r_plain}${NC}"
        else
            r_styled="${r_plain}"
        fi

        append "${B_CYAN}│${NC}%s${B_CYAN}│${NC}%s${B_CYAN}│${NC}" "$l_styled" "$r_styled"
    done

    # Notification Row (max 63 chars, padded to 65)
    append "${B_CYAN}├─────────────────────────────────────────────────────────────────┤${NC}"
    local msg=" > ${LAST_MSG}"
    local msg_plain="${msg:0:63}"
    local pad_m=$((inner_w - ${#msg_plain}))
    if ((pad_m < 0)); then pad_m=0; fi
    append "${B_CYAN}│${NC}%s%*s${B_CYAN}│${NC}" "$msg_plain" "$pad_m" ""

    # Keybindings Footer Rows
    append "${B_CYAN}├─────────────────────────────────────────────────────────────────┤${NC}"
    local k1=" ↑/↓, j/k: Nav    Enter/Space: Apply Preset    Tab: Switch Col   "
    local k2=" ←/→, h/l: Step ±2%  [/]: ±8%   a: Auto   c: Custom   q: Quit    "
    append "${B_CYAN}│${NC}${DIM}%s${NC}${B_CYAN}│${NC}" "$k1"
    append "${B_CYAN}│${NC}${DIM}%s${NC}${B_CYAN}│${NC}" "$k2"
    append "${B_CYAN}╰─────────────────────────────────────────────────────────────────╯${NC}"

    # Atomic write to screen in one single buffer flush
    printf "%b" "$buf"
}

# --- Input Reading (Filter Mouse Motion & Parse Keys) ---
read_key() {
    local key rest rest2
    if ! IFS= read -rsn1 key 2>/dev/null; then
        echo "EOF"
        return
    fi
    if [[ "$key" == $'\x1b' ]]; then
        # Read the next character with a small timeout
        if ! read -rsn1 -t 0.02 rest 2>/dev/null; then
            echo "ESC"
            return
        fi
        if [[ "$rest" == "[" || "$rest" == "O" ]]; then
            if ! read -rsn1 -t 0.02 rest2 2>/dev/null; then
                echo "IGNORE"
                return
            fi

            # Mouse tracking sequences (drop completely)
            if [[ "$rest2" == "<" ]]; then
                # SGR mouse sequence: consume until M or m
                local mouse_char=""
                while read -rsn1 -t 0.02 mouse_char 2>/dev/null; do
                    if [[ "$mouse_char" == "M" || "$mouse_char" == "m" ]]; then
                        break
                    fi
                done
                echo "IGNORE"
                return
            elif [[ "$rest2" == "M" ]]; then
                # X10 mouse sequence: consume 3 bytes
                read -rsn3 -t 0.02 2>/dev/null
                echo "IGNORE"
                return
            fi

            case "$rest2" in
            'A') echo "UP" ;;
            'B') echo "DOWN" ;;
            'C') echo "RIGHT" ;;
            'D') echo "LEFT" ;;
            'H') echo "HOME" ;;
            'F') echo "END" ;;
            'Z') echo "BTAB" ;; # Shift-Tab
            *) echo "IGNORE" ;;
            esac
        else
            echo "ESC"
        fi
    elif [[ "$key" == $'\t' ]]; then
        echo "TAB"
    elif [[ -z "$key" ]]; then
        echo "ENTER"
    else
        echo "$key"
    fi
}

# --- Main Controller Loop ---

main() {
    # Subcommands (CLI & tmux integrations): plain stdout, no terminal tricks
    case "${1:-}" in
    "popup")
        if [ -n "${TMUX:-}" ]; then
            exec tmux display-popup -b rounded -w 71 -h 27 -E "$0"
        else
            echo "Not running inside tmux. Launching TUI directly..."
        fi
        ;;
    "status" | "-s")
        # Used by status bars: never fail, never hang
        require_device 2>/dev/null || {
            echo "☀ --"
            exit 0
        }
        if read_state; then
            local pct=$((CURRENT_VAL * 100 / MAX_VAL))
            if [ "$AUTO_MODE" -eq 1 ]; then
                echo "☀ ${pct}% (Auto)"
            else
                echo "☀ ${pct}%"
            fi
        else
            echo "☀ --"
        fi
        exit 0
        ;;
    "up" | "+" | "down" | "-")
        require_device || exit 1
        read_state || {
            echo "Could not read brightness from the device." >&2
            exit 1
        }
        local step="${2:-$((MAX_VAL * 6 / 100))}"
        [[ $step =~ ^[0-9]+$ ]] || {
            echo "Step must be a number." >&2
            exit 1
        }
        local target
        case "$1" in
        "up" | "+") target=$((CURRENT_VAL + step)) ;;
        *) target=$((CURRENT_VAL - step)) ;;
        esac
        ((target > MAX_VAL)) && target=$MAX_VAL
        ((target < 1)) && target=1
        set_brightness "$target" || {
            echo "adb command failed." >&2
            exit 1
        }
        echo "Brightness: $target ($((target * 100 / MAX_VAL))%)"
        exit 0
        ;;
    "set")
        require_device || exit 1
        read_state || true # only needed for MAX_VAL
        local target="${2:-$((MAX_VAL / 2))}"
        if [[ "$target" =~ ^[0-9]+$ ]] && ((target >= 1 && target <= MAX_VAL)); then
            set_brightness "$target" || {
                echo "adb command failed." >&2
                exit 1
            }
            echo "Brightness: $target ($((target * 100 / MAX_VAL))%)"
        else
            echo "Usage: adb_brightness set <1-${MAX_VAL}>" >&2
            exit 1
        fi
        exit 0
        ;;
    "toggle" | "auto")
        require_device || exit 1
        read_state || true
        if [ "$AUTO_MODE" -eq 1 ]; then
            adbx shell settings put system screen_brightness_mode 0 && echo "Auto-brightness disabled (Manual Mode)"
        else
            adbx shell settings put system screen_brightness_mode 1 && echo "Auto-brightness enabled (Adaptive)"
        fi
        exit $?
        ;;
    "-h" | "--help" | "help")
        echo "Usage: adb_brightness [COMMAND]"
        echo ""
        echo "Commands:"
        echo "  (none)      Open full interactive TUI"
        echo "  popup       Open floating popup in tmux"
        echo "  status, -s  Print one-line brightness for status bar"
        echo "  up, + [N]   Increase brightness by N (default: ~6% of range)"
        echo "  down, - [N] Decrease brightness by N (default: ~6% of range)"
        echo "  set <val>   Set brightness to specific value (1-max, max auto-detected)"
        echo "  toggle      Toggle auto/adaptive brightness"
        echo ""
        echo "Env: ANDROID_SERIAL=<id> selects a device when several are connected."
        exit 0
        ;;
    esac

    require_device || exit 1
    local rows cols
    rows=$(tput lines 2>/dev/null || echo 25)
    cols=$(tput cols 2>/dev/null || echo 67)
    if ((rows < 25 || cols < 67)); then
        echo "Terminal too small: need 67x25, have ${cols}x${rows}." >&2
        exit 1
    fi
    fetch_device_info
    tui_setup

    # Clear once at startup
    clear

    local need_render=1

    while true; do
        if [ "$need_render" -eq 1 ]; then
            render_tui
            need_render=0
        fi

        local key
        key=$(read_key)

        case "$key" in
        # Filter mouse motion: do nothing and do NOT redraw
        "IGNORE")
            ;;

        # Navigation: Up
        "UP" | [kK])
            if [ "$SELECTED_INDEX" -gt 0 ]; then
                SELECTED_INDEX=$((SELECTED_INDEX - 1))
            else
                SELECTED_INDEX=$((TOTAL_PRESETS - 1))
            fi
            need_render=1
            ;;

        # Navigation: Down
        "DOWN" | [jJ])
            if [ "$SELECTED_INDEX" -lt $((TOTAL_PRESETS - 1)) ]; then
                SELECTED_INDEX=$((SELECTED_INDEX + 1))
            else
                SELECTED_INDEX=0
            fi
            need_render=1
            ;;

        # Switch Column
        "TAB" | "BTAB")
            if [ "$SELECTED_INDEX" -lt 10 ]; then
                SELECTED_INDEX=$((SELECTED_INDEX + 10))
                if [ "$SELECTED_INDEX" -ge "$TOTAL_PRESETS" ]; then
                    SELECTED_INDEX=$((TOTAL_PRESETS - 1))
                fi
            else
                SELECTED_INDEX=$((SELECTED_INDEX - 10))
            fi
            need_render=1
            ;;

        # Step Slider: Left (Decrease)
        "LEFT" | [hH] | "-")
            apply_brightness $((CURRENT_VAL - STEP)) ""
            need_render=1
            ;;

        # Step Slider: Right (Increase)
        "RIGHT" | [lL] | "+")
            apply_brightness $((CURRENT_VAL + STEP)) ""
            need_render=1
            ;;

        # Coarse Step Slider: [ or ]
        "[")
            apply_brightness $((CURRENT_VAL - COARSE)) ""
            need_render=1
            ;;
        "]")
            apply_brightness $((CURRENT_VAL + COARSE)) ""
            need_render=1
            ;;

        # Apply Selected Preset
        "ENTER" | " ")
            local sel_val=${PRESETS_VAL[SELECTED_INDEX]}
            local sel_name=${PRESETS_NAME[SELECTED_INDEX]}
            apply_brightness "$sel_val" "$sel_name"
            need_render=1
            ;;

        # Quick Shortcuts
        "0" | [mM])
            # Pitch Dark / Minimum
            apply_brightness 1 "Pitch Dark / Minimum"
            need_render=1
            ;;
        "9" | "$" | [xX])
            # 100% Maximum
            apply_brightness "$MAX_VAL" "Maximum"
            need_render=1
            ;;

        # Auto-Brightness Toggle
        [aA])
            toggle_auto_mode
            need_render=1
            ;;

        # Custom Value Prompt
        [cC])
            prompt_custom_value
            need_render=1
            ;;

        # Refresh Device Info
        [rR])
            fetch_device_info
            LAST_MSG="Status refreshed from device."
            need_render=1
            ;;

        # Exit
        "EOF" | "ESC" | [qQ])
            break
            ;;

        *)
            # Unknown key: do nothing, do NOT re-render
            ;;
        esac
    done
}

main "$@"
